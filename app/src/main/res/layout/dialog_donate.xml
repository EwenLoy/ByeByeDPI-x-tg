<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/donateMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/donate_message"
        android:textAppearance="?attr/textAppearanceBody2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/donateAuthorButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textSize="15sp"
        app:icon="@drawable/ic_favorite"
        app:iconGravity="textStart"
        android:text="@string/donate_ewenloy_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/donateContributorsButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/donate_contributors_button" />

    <TextView
        android:id="@+id/donateThanks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/donate_thanks"
        android:textAppearance="?attr/textAppearanceCaption" />

</LinearLayout>
